# Copy to .env and fill in. .env is gitignored — never commit it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=badminton
ADMIN_PASSWORD=change-me
# Pin this so a server restart does not sign the scorers out.
SESSION_SECRET=
PORT=3100

# Gemini, for the assistant bubble.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Keeping a free host awake. Set this to the public URL once deployed
# (leave blank locally). The server pings itself every KEEP_AWAKE_MINUTES.
KEEP_AWAKE_URL=
KEEP_AWAKE_MINUTES=12
